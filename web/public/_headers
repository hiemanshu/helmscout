# Applied by Cloudflare Pages from the root of web/dist (vite copies web/public/*).
# A CSP is deliberately not set: the API origin is chosen at runtime via
# /config.json, so a static policy cannot express connect-src correctly.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/config.json
  Cache-Control: public, max-age=300

/favicon.svg
  Cache-Control: public, max-age=86400
